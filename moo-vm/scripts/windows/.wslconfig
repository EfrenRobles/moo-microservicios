[wsl2]
# 4GB is the minimum required to run 4 microservices + containers
memory=4GB 

# Leave at least 2 free cores so that the mouse can continue moving
processors=6

# It makes WSL2 and Windows share the same localhost IP address
networkingMode=mirrored

# A 20GB swap
swap=20GB

[experimental]
# Aggressively recovers RAM
autoMemoryReclaim=gradual

# Optimizes CPU usage when WSL2 is iddle
# idleManager=true

# Crucial to prevent the .vhdx file from growing to infinite
# sparseVhd=true
